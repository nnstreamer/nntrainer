    "weight_bits": 2,
    "canonical_layout_bytes": "[N/128][K/32][8][128]",
    "column_mapping": "Byte j in each 128-byte vector corresponds to output (j%4)*32+j/4 within its panel.",
    "byte_mapping": "For t=0..7: bits 0..1 code row 2t; bits 2..3 row 2t+1; bits 4..5 row 16+2t; bits 6..7 row 17+2t, relative to the K32 tile.",
    "runtime_layout": "[K/32][N/128][8][128], with N*16-byte K-row stride. Compact source occupies the upper N*8 bytes; the transformed layout occupies the lower N*8 bytes.",
    "lut_storage": "K*32 bytes, 128-byte aligned; 64 KiB for K=2048. Prepared once per activation/palette, reused across N panels.",
    "partial_sum_bound": "Eight pairs in signed int16: [-32640,28560]; widen to int32 before combining groups.",
    "metadata": "Palette, per-column scales, zero-point compensation column sums and output order preserved.",
    "model_format": "Original QS2CX_WH model file/cache format retained; runtime conversion in VTCM. New layout must not be identified as QS2CX_WH.",
    "future_work": "Persist a distinct LUT weight layout in expert cache or model format to avoid per-token repacking; retain an appropriate prefill representation."
  },
