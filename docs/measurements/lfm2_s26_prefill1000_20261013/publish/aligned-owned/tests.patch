+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Run actual O_DIRECT owned-envelope tests; requires Linux/Android filesystem."""
+import argparse
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+
+p = argparse.ArgumentParser(description=__doc__)
+p.add_argument('--repo-root', type=Path)
+p.add_argument('--sanitize', action='store_true')
+a = p.parse_args()
+here = Path(__file__).resolve().parent
+root = a.repo_root.resolve() if a.repo_root else here.parents[2]
+compiler = shlex.split(os.environ.get('CXX', 'c++'))
+flags = ['-std=c++17', '-O1' if a.sanitize else '-O2', '-Wall', '-Wextra', '-Werror', '-pthread']
+env = os.environ.copy()
+if a.sanitize:
+    flags += ['-fsanitize=address,undefined', '-fno-omit-frame-pointer', '-g1']
+    env['ASAN_OPTIONS'] = 'halt_on_error=1:detect_leaks=1'
+    env['UBSAN_OPTIONS'] = 'halt_on_error=1'
+includes = ['-I' + str(x) for x in [here, root / 'nntrainer/utils', root / 'nntrainer/tensor/htp_backend']]
+with tempfile.TemporaryDirectory(prefix='nntr-owned-envelope-') as tmp:
+    for name in ['weight_direct_file_check', 'owned_envelope_check']:
+        binary = Path(tmp) / name
+        wrap = ['-Wl,--wrap=pread', '-Wl,--wrap=free', '-Wl,--wrap=posix_memalign'] if name == 'owned_envelope_check' else []
+        command = compiler + flags + includes + [str(here / (name + '.cpp'))] + wrap + ['-o', str(binary)]
+        subprocess.run(command, check=True)
+        subprocess.run([str(binary)], env=env, check=True, timeout=60)
+    portable = Path(tmp) / 'portable.cpp'
+    portable.write_text('#include "weight_direct_file.h"\n#include "htp_expert_host_staging.h"\nint main() { return 0; }\n')
+    subprocess.run(compiler + ['-std=c++17', '-Wall', '-Wextra', '-Werror', '-U__linux__', '-U__ANDROID__'] + includes + ['-fsyntax-only', str(portable)], check=True)
+    print('PASS portable headers without Linux/Android macros')
