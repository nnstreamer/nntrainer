+// SPDX-License-Identifier: Apache-2.0
+/** @file owned_envelope_check.cpp
+ * @brief Actual O_DIRECT envelope reads, metadata parity, bounds and ownership.
+ */
+#include "expert_host_staging_fixture.h"
+#include "weight_direct_file.h"
+#include <cstdio>
+#if defined(__linux__) || defined(__ANDROID__)
+#include <cmath>
+#include <tuple>
+using namespace nntrainer;
+
+extern "C" ssize_t __real_pread(int, void *, size_t, off_t);
+extern "C" void __real_free(void *);
+extern "C" int __real_posix_memalign(void **, size_t, size_t);
+struct ReadCall {
+  uintptr_t dst;
+  size_t bytes;
+  off_t offset;
+  int flags;
+};
+struct ReadProbe {
+  std::vector<ReadCall> calls;
+  enum Fault { none, interrupt, error, zero, short_read } fault = none;
+  size_t short_bytes = 0;
+};
+thread_local ReadProbe *read_probe;
+std::atomic<bool> fail_alloc{false};
+struct FreeProbe {
+  std::atomic<void *> target{nullptr};
+  std::mutex mutex;
+  std::condition_variable cv;
+  bool entered = false, release = false, freed = false;
+  std::atomic<unsigned> deletes{0}, frees{0};
+} free_probe;
+extern "C" ssize_t __wrap_pread(int fd, void *dst, size_t n, off_t off) {
+  auto *probe = read_probe;
+  if (probe) {
+    probe->calls.push_back(
+      {reinterpret_cast<uintptr_t>(dst), n, off, fcntl(fd, F_GETFL)});
+    auto fault = probe->fault;
+    probe->fault = ReadProbe::none;
+    if (fault == ReadProbe::interrupt) {
+      errno = EINTR;
+      return -1;
+    }
+    if (fault == ReadProbe::error) {
+      errno = EIO;
+      return -1;
+    }
+    if (fault == ReadProbe::zero)
+      return 0;
+    if (fault == ReadProbe::short_read) {
+      const auto got = __real_pread(fd, dst, n, off);
+      return got < 0 ? got : std::min<size_t>(got, probe->short_bytes);
+    }
+  }
+  return __real_pread(fd, dst, n, off);
+}
+extern "C" int __wrap_posix_memalign(void **p, size_t a, size_t n) {
+  if (fail_alloc.exchange(false))
+    return ENOMEM;
+  return __real_posix_memalign(p, a, n);
+}
+extern "C" void __wrap_free(void *p) {
+  const bool watched = p && p == free_probe.target.load();
+  if (watched) {
+    ++free_probe.frees;
+    std::unique_lock<std::mutex> lock(free_probe.mutex);
+    free_probe.entered = true;
+    free_probe.cv.notify_all();
+    free_probe.cv.wait(lock, [] { return free_probe.release; });
+  }
+  __real_free(p);
+  if (watched) {
+    std::lock_guard<std::mutex> lock(free_probe.mutex);
+    free_probe.freed = true;
+    free_probe.cv.notify_all();
+  }
+}
+void *operator new[](size_t bytes) { return ::operator new(bytes); }
+void operator delete[](void *p) noexcept {
+  if (p && p == free_probe.target.load())
+    ++free_probe.deletes;
+  ::operator delete(p);
+}
+void operator delete[](void *p, size_t) noexcept { ::operator delete[](p); }
+
+struct Allocation {
+  uint8_t *base = nullptr;
+  size_t span;
+  Allocation(size_t bytes, size_t head) :
+    span((bytes + head + 4095) / 4096 * 4096) {
+    void *p = nullptr;
+    require(!posix_memalign(&p, 4096, span + 8192));
+    base = static_cast<uint8_t *>(p);
+    std::memset(base, 0xcd, span + 8192);
+  }
+  ~Allocation() { std::free(base); }
+  uint8_t *data() { return base + 4096; }
+  void guards() {
+    require(
+      std::all_of(base, base + 4096, [](uint8_t b) { return b == 0xcd; }));
+    require(std::all_of(data() + span, data() + span + 4096,
+                        [](uint8_t b) { return b == 0xcd; }));
+  }
+};
+std::vector<uint8_t> rawRecord(unsigned k, unsigned n) {
+  const size_t codes = size_t(k) * n / 4;
+  std::vector<uint8_t> data(codes + 8 * n + 4);
+  for (size_t i = 0; i < codes; ++i)
+    data[i] = uint8_t(i * 37 + i / 97);
+  const int8_t palette[4] = {-8, -1, 0, 7};
+  std::memcpy(data.data() + codes, palette, 4);
+  for (unsigned i = 0; i < n; ++i) {
+    float scale = float(i + 1) / 137.0f;
+    float sum = float(int(i % 59) - 29) + 0.75f;
+    std::memcpy(data.data() + codes + 4 + 4 * i, &scale, 4);
+    std::memcpy(data.data() + codes + 4 + 4 * (n + i), &sum, 4);
+  }
+  return data;
+}
+std::vector<uint8_t> converted(const std::vector<uint8_t> &raw, unsigned k,
+                               unsigned n) {
+  std::vector<uint8_t> result(raw.size()), scratch;
+  require(!htpReadQs2Compact(
+    [&](void *dst, size_t bytes, uint64_t off) {
+      if (off > raw.size() || bytes > raw.size() - off)
+        return -1;
+      std::memcpy(dst, raw.data() + off, bytes);
+      return 0;
+    },
+    0, k, n, result.data(), false, scratch));
+  return result;
+}
+int ownedRecord(Bank::Record &r, WeightDirectFiles &files) {
+  auto part = [&](bool down, uint64_t off, unsigned k, unsigned n) {
+    return htpReadQs2CompactInPlace(
+      [&](void *dst, size_t count, uint64_t at) {
+        require(dst == r.data(down));
+        return files.readOwnedEnvelope(r.fd(), r.envelope(down),
+                                       r.envelopeBytes(down), count, at);
+      },
+      off, k, n, r.data(down), down ? r.dn_bytes : r.gu_bytes);
+  };
+  int rc = part(false, r.d.off_gu, r.d.K, 2 * r.d.inter);
+  return rc ? rc : part(true, r.d.off_dn, r.d.inter, r.d.N_out);
+}
+int main() {
+  char path[] = "/tmp/nntr-owned-direct-XXXXXX";
+  int fd = mkstemp(path);
+  require(fd >= 0);
+  unlink(path);
+  const auto small = rawRecord(32, 64);
+  const auto expected = converted(small, 32, 64);
+  const size_t large_offset = 4096 * 8192u;
+  for (size_t head = 0; head < 4096; ++head)
+    require(pwrite(fd, small.data(), small.size(), head * 8192 + head) ==
+            ssize_t(small.size()));
+  auto gu = rawRecord(2048, 3072), dn = rawRecord(1536, 2048);
+  const uint64_t gu_off = large_offset + 4095;
+  const uint64_t dn_off = large_offset + 4 * 1024 * 1024 + 3068;
+  require(pwrite(fd, gu.data(), gu.size(), gu_off) == ssize_t(gu.size()));
+  require(pwrite(fd, dn.data(), dn.size(), dn_off) == ssize_t(dn.size()));
+  require((dn_off + dn.size()) % 4096 == 3072);
+  require(fsync(fd) == 0);
+  const auto flags = fcntl(fd, F_GETFL);
+  require(lseek(fd, 29, SEEK_SET) == 29);
+  WeightDirectFiles files;
+  // Exercise every possible record head, including byte-unaligned metadata.
+  for (size_t head = 0; head < 4096; ++head) {
+    Allocation out(small.size(), head);
+    ReadProbe probe;
+    read_probe = &probe;
+    int rc = htpReadQs2CompactInPlace(
+      [&](void *dst, size_t count, uint64_t off) {
+        require(dst == out.data() + head);
+        return files.readOwnedEnvelope(fd, out.data(), out.span, count, off);
