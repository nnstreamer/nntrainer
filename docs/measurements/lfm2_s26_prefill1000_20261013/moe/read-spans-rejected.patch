+        return EINVAL;
+      const int rc = read_spans(dst, codes, out, bytes, off);
+      record_read = rc == 0;
+      return rc;
+    }
+    return out == dst && bytes == codes && at == off ? 0 : EINVAL;
+  };
+  // All shape/overflow checks happen in the existing reader before read().
+  return htpReadQs2Compact(read, off, K, N, dst, true, scratch, stats);
