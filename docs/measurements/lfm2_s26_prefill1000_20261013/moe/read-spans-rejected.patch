+template <typename ReadSpans>
+int htpReadQs2CompactSpans(ReadSpans read_spans, uint64_t off, uint32_t K,
+                           uint32_t N, uint8_t *dst,
+                           std::vector<uint8_t> &scratch,
+                           HtpQs2ReadStats *stats = nullptr) {
