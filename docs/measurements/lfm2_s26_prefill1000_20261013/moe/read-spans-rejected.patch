+// SPDX-License-Identifier: Apache-2.0
+/** Check actual contiguous O_DIRECT records split into two private spans. */
+#if defined(__linux__) || defined(__ANDROID__)
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <string>
+#include <thread>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+struct ReadProbe {
+  bool enabled = false;
+  unsigned fail_at = 0, short_at = 0, interrupt_at = 0, calls = 0;
+  std::vector<std::pair<uint64_t, size_t>> requests;
+};
+static thread_local ReadProbe probe;
+static ssize_t observed_pread(int fd, void *dst, size_t bytes, off_t offset);
+#define pread observed_pread
+#include "weight_direct_file.h"
+#undef pread
+#include "htp_qs2_reader.h"
+
+static ssize_t observed_pread(int fd, void *dst, size_t bytes, off_t offset) {
+  if (!probe.enabled)
+    return ::pread(fd, dst, bytes, offset);
+  ++probe.calls;
+  probe.requests.emplace_back(static_cast<uint64_t>(offset), bytes);
+  if (probe.calls == probe.fail_at || probe.calls == probe.interrupt_at) {
+    errno = probe.calls == probe.interrupt_at ? EINTR : EIO;
+    return -1;
+  }
+  const ssize_t got = ::pread(fd, dst, bytes, offset);
+  return probe.calls == probe.short_at && got > 0 ? got - 1 : got;
+}
+
+using Clock = std::chrono::steady_clock;
+static constexpr size_t GU = 1597444, DN = 802820;
+static std::atomic<unsigned> cases{0};
+static void require(bool ok, const char *what) {
+  if (!ok) {
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    std::exit(1);
+  }
+}
+static void resetProbe(unsigned fail = 0, unsigned short_read = 0,
+                       unsigned interrupt = 0) {
+  probe = ReadProbe{};
+  probe.enabled = true;
+  probe.fail_at = fail;
+  probe.short_at = short_read;
+  probe.interrupt_at = interrupt;
+}
+static std::vector<uint8_t> record(uint32_t K, uint32_t N) {
+  const size_t codes = size_t(K) * N / 4;
+  std::vector<uint8_t> bytes(codes + 4 + size_t(N) * 8);
+  for (size_t i = 0; i < codes; ++i)
+    bytes[i] = uint8_t(i * 17u + i / 251u);
+  const int8_t palette[4] = {-8, -3, 2, 7};
+  std::memcpy(bytes.data() + codes, palette, sizeof palette);
+  for (uint32_t i = 0; i < N; ++i) {
+    const float scale = (i + 1) * 0.03125f;
+    const float sum = float(int(i % (8u * K)) - int(4u * K));
+    std::memcpy(bytes.data() + codes + 4 + size_t(i) * 4, &scale, 4);
+    std::memcpy(bytes.data() + codes + 4 + size_t(N + i) * 4, &sum, 4);
+  }
+  return bytes;
+}
+static int writeFile(const std::string &dir, const std::vector<uint8_t> &data) {
+  std::string path = dir + "/nntr-spans-XXXXXX";
+  std::vector<char> name(path.begin(), path.end());
+  name.push_back(0);
+  const int fd = mkstemp(name.data());
+  require(fd >= 0, "mkstemp");
+  require(!unlink(name.data()), "unlink private fixture");
+  size_t done = 0;
+  while (done < data.size()) {
+    const ssize_t n = write(fd, data.data() + done, data.size() - done);
+    if (n < 0 && errno == EINTR)
+      continue;
+    require(n > 0, "fixture write");
+    done += size_t(n);
+  }
+  require(!fsync(fd), "fixture fsync");
+  return fd;
+}
+static void compareRead(nntrainer::WeightDirectFiles &original,
+                        nntrainer::WeightDirectFiles &candidate, int fd,
+                        const std::vector<uint8_t> &data, uint64_t at,
+                        size_t bytes, size_t split, size_t shift) {
+  std::vector<uint8_t> reference(bytes + 256, 0xa5);
+  std::vector<uint8_t> first(split + shift + 128, 0xa5);
+  std::vector<uint8_t> second(bytes - split + shift + 128, 0xa5);
+  resetProbe();
+  const int a = original.read(fd, reference.data() + 128, bytes, at);
+  const auto requests = probe.requests;
+  resetProbe();
+  const int b = candidate.readSpans(fd, first.data() + shift, split,
+                                    second.data() + shift, bytes - split, at);
+  const int expected = at <= data.size() && bytes <= data.size() - at ? 0 : -1;
+  require(a == expected && b == a, "split/ordinary status");
+  require(probe.requests == requests, "identical forward pread sequence");
+  require(std::all_of(first.begin(), first.begin() + shift,
+                      [](uint8_t x) { return x == 0xa5; }) &&
+            std::all_of(first.end() - 128, first.end(),
+                        [](uint8_t x) { return x == 0xa5; }) &&
+            std::all_of(second.begin(), second.begin() + shift,
+                        [](uint8_t x) { return x == 0xa5; }) &&
+            std::all_of(second.end() - 128, second.end(),
+                        [](uint8_t x) { return x == 0xa5; }),
+          "destination guards");
+  if (!a) {
+    require(!std::memcmp(first.data() + shift, reference.data() + 128, split),
+            "first span bytes");
+    require(!std::memcmp(second.data() + shift, reference.data() + 128 + split,
+                         bytes - split),
+            "second span bytes");
+    require(!bytes ||
+              !std::memcmp(reference.data() + 128, data.data() + at, bytes),
+            "independent source bytes");
+  } else {
+    require(std::all_of(first.begin(), first.end(),
+                        [](uint8_t x) { return x == 0xa5; }) &&
+              std::all_of(second.begin(), second.end(),
+                          [](uint8_t x) { return x == 0xa5; }),
+            "range error leaves both spans untouched");
+  }
+  ++cases;
+}
+static void checkMetadata(uint32_t K, uint32_t N) {
+  auto data = record(K, N);
+  const size_t codes = size_t(K) * N / 4;
+  std::vector<uint8_t> reference(data.size() + 256, 0xa5), actual(reference),
+    a_scratch, b_scratch;
+  unsigned ordinary_calls = 0, span_calls = 0;
+  auto ordinary = [&](void *out, size_t n, uint64_t at) {
+    ++ordinary_calls;
+    require(at == 0 && n == data.size(), "one original whole-record read");
+    std::memcpy(out, data.data(), n);
+    return 0;
+  };
+  auto spans = [&](void *head, size_t n, void *tail, size_t m, uint64_t at) {
+    ++span_calls;
+    require(at == 0 && n == codes && n + m == data.size(),
+            "one split whole-record read");
+    std::memcpy(head, data.data(), n);
+    std::memcpy(tail, data.data() + n, m);
+    return 0;
+  };
+  nntrainer::HtpQs2ReadStats stats;
+  require(!nntrainer::htpReadQs2Compact(
+            ordinary, 0, K, N, reference.data() + 128, false, a_scratch),
+          "original metadata parse");
+  require(!nntrainer::htpReadQs2CompactSpans(
+            spans, 0, K, N, actual.data() + 128, b_scratch, &stats),
+          "split metadata parse");
+  require(reference == actual && ordinary_calls == 1 && span_calls == 1,
+          "complete slot bytes and one callback exact");
+  require(b_scratch.size() == 4 + 8u * N && stats.copied_bytes == 0,
+          "bounded metadata scratch and no full packed copy");
+  ++cases;
+  const auto valid = data;
+  for (int8_t invalid : {int8_t(-9), int8_t(8)}) {
+    data = valid;
+    data[codes] = uint8_t(invalid);
+    std::fill(actual.begin(), actual.end(), 0xa5);
+    require(nntrainer::htpReadQs2CompactSpans(
+              spans, 0, K, N, actual.data() + 128, b_scratch) == EINVAL,
+            "palette rejected before success/publication");
+    require(std::all_of(actual.begin() + 128 + codes, actual.end(),
+                        [](uint8_t x) { return x == 0xa5; }),
+            "invalid palette cannot publish metadata");
+    ++cases;
+  }
+  for (float invalid :
+       {std::numeric_limits<float>::quiet_NaN(),
+        std::numeric_limits<float>::infinity(), float(8u * K + 1u)}) {
+    data = valid;
+    std::memcpy(data.data() + codes + 4 + size_t(N) * 4, &invalid, 4);
+    std::fill(actual.begin(), actual.end(), 0xa5);
+    require(nntrainer::htpReadQs2CompactSpans(
+              spans, 0, K, N, actual.data() + 128, b_scratch) == EINVAL,
+            "column sum rejected before success/publication");
+    require(std::all_of(actual.begin() + 128 + codes, actual.end(),
+                        [](uint8_t x) { return x == 0xa5; }),
+            "invalid column sum cannot publish metadata");
+    ++cases;
+  }
+  data = valid;
+  for (int error : {-1, EIO}) {
+    unsigned calls = 0;
+    auto fail = [&](void *, size_t, void *, size_t, uint64_t) {
+      ++calls;
+      return error;
+    };
+    require(nntrainer::htpReadQs2CompactSpans(
+              fail, 0, K, N, actual.data() + 128, b_scratch) == error &&
+              calls == 1,
+            "I/O error propagated without second read");
+    ++cases;
+  }
+  unsigned invalid_calls = 0;
+  auto unexpected = [&](void *, size_t, void *, size_t, uint64_t) {
+    ++invalid_calls;
+    return EIO;
+  };
+  for (auto shape :
+       {std::pair<uint32_t, uint32_t>{0, N}, {K, 0}, {31, N}, {K, 33}})
+    require(nntrainer::htpReadQs2CompactSpans(unexpected, 0, shape.first,
+                                              shape.second, actual.data() + 128,
+                                              b_scratch) == EINVAL,
+            "invalid shape rejected before read");
+  require(nntrainer::htpReadQs2CompactSpans(unexpected, UINT64_MAX, K, N,
+                                            actual.data() + 128,
+                                            b_scratch) == EINVAL &&
+            !invalid_calls,
+          "offset overflow rejected before read");
+  ++cases;
+}
+static void checkDiskMetadata(const std::string &dir, uint32_t K, uint32_t N,
+                              size_t offset) {
+  const auto compact = record(K, N);
+  std::vector<uint8_t> data(offset + compact.size(), 0x63);
+  std::memcpy(data.data() + offset, compact.data(), compact.size());
+  const int fd = writeFile(dir, data);
+  nntrainer::WeightDirectFiles original;
+  nntrainer::WeightDirectFiles candidate;
+  std::vector<uint8_t> reference(compact.size() + 256, 0xa5), actual(reference),
+    a_scratch, b_scratch;
+  resetProbe();
+  const int a = nntrainer::htpReadQs2Compact(
+    [&](void *out, size_t n, uint64_t at) {
+      return original.read(fd, out, n, at);
+    },
+    offset, K, N, reference.data() + 128, false, a_scratch);
+  const auto requests = probe.requests;
+  resetProbe();
+  const int b = nntrainer::htpReadQs2CompactSpans(
+    [&](void *head, size_t n, void *tail, size_t m, uint64_t at) {
+      return candidate.readSpans(fd, head, n, tail, m, at);
+    },
+    offset, K, N, actual.data() + 128, b_scratch);
+  require(!a && b == a && reference == actual && probe.requests == requests,
+          "actual disk compact loader byte/status/pread parity");
+  require(probe.calls == (compact.size() > 1044480 ? 2u : 1u),
+          "actual GU two preads, DN one pread");
+  close(fd);
+  ++cases;
+}
