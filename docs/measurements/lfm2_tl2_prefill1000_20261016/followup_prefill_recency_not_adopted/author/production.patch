+        dn.getDataType() != nntrainer::Tdatatype::TL2CX_WH || gu.batch() != 1 ||
+        gu.channel() != 1 || dn.batch() != 1 || dn.channel() != 1 ||
+        gu.height() != 2048 || gu.width() != 3072 || dn.height() != 1536 ||
+        dn.width() != 2048)
+      return false;
+  }
+  return true;
+}
