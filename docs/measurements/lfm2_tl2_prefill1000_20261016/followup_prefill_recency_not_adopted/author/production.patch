+      rows.height() != 1 || rows.width() != 2048 ||
+      rows.getDataType() != nntrainer::Tdatatype::FP32 ||
+      rows.getFormat() != nntrainer::Tformat::NCHW || !rows.getContiguous() ||
+      rows.getOps() != nntrainer::get_htp_ops() || rows.getOps() == nullptr ||
+      gate_up_indices.size() != 64 || down_indices.size() != 64)
+    return false;
+  for (size_t e = 0; e < 64; ++e) {
